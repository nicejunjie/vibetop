[Unit]
Description=Terminal manager API (start/stop terminal instances on demand)
After=network.target
# Crash-loop guard: tolerate flapping (a bad deploy, a transient dependency) but
# give up after 10 failures in 5 min instead of hot-looping forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Optional host-local overrides (absent on a default home install → no-op). The
# /opt/vibetop migration writes this to point ADMIN users + secret paths at the
# system tree: VIBETOP_ADMINS, ONLYOFFICE_SECRET_FILE, SESSION_SECRET_FILE.
EnvironmentFile=-/etc/vibetop/manager.env
ExecStart=/usr/bin/python3 @APP_DIR@/terminal-manager.py @BASE_PORT@
Restart=on-failure
RestartSec=2
# Liveness watchdog: the manager pets this only while a loopback GET /api/ping
# actually answers (see _watchdog_loop), so a WEDGED process — stuck accept
# loop, exhausted threads, deadlock — is restarted, not just a crashed one
# (which Restart=on-failure already covers). 60s window, petted every ~20s, so
# two consecutive missed probes are tolerated before a restart (no flapping
# under a brief load spike). A watchdog kill exits non-zero → Restart fires.
WatchdogSec=60

# ---- memory ceiling ---------------------------------------------------------
# MEASURED on the reference host: RSS 970MB after 8h, systemd MemoryPeak 2.03GB,
# with no limit of any kind. It is RETENTION, not a leak — RSS is flat at idle —
# but it ratchets: ~940MB of it sits in per-thread glibc malloc ARENAS, not the
# Python heap ([heap] was 17MB). This is a ThreadingHTTPServer with a thread per
# request and no pool, and glibc gives a 32-core host up to 8*32 arenas of 64MB.
# Every burst of concurrency raises the floor and it never comes back down, in a
# process that normally runs for WEEKS between deploys.
#
# Two ceilings rather than a cap that kills:
#   MALLOC_ARENA_MAX bounds the cause — far fewer arenas, so transient
#   concurrency stops carving new 64MB regions that are never returned.
#   MemoryHigh throttles and reclaims at the limit instead of OOM-killing, so a
#   genuine spike degrades rather than dropping every terminal on the host.
# No MemoryMax on purpose: this service is the one that must not die.
#
# THE CEILING MUST CLEAR ANON *PLUS* RECLAIMABLE SLAB — and I sized it wrong
# twice before measuring properly.
#   1500M, taken from the 970MB IDLE rss: throttled the process's real working
#   set 8979 times in three minutes and turned a 2s request into SIXTY (nginx's
#   read timeout). MemoryHigh does not reduce what a process needs; it makes it
#   fight for it.
#   3G, taken from a 2.03GB peak measured on OLDER code: exceeded as well —
#   MemoryPeak 3.22GB, 727 "high" events. But measuring the breakdown showed
#   those were harmless: memory.stat was anon 1.00GB (essentially the
#   pre-MALLOC_ARENA_MAX baseline) against 1.90GB of slab, ALL of it
#   slab_reclaimable — dentry/inode cache from `du`-ing every home and reading
#   629 transcripts. The cgroup charges that cache here, so the kernel was
#   reclaiming exactly what MemoryHigh exists to reclaim, and request latency
#   stayed at 0.5-1.5ms throughout.
# 4G clears anon plus that cache, so the ceiling guards runaway instead of
# nibbling the page cache on every filesystem walk. A climbing "high" counter is
# only a problem when latency moves with it — check both, never just the counter.
Environment=MALLOC_ARENA_MAX=2
MemoryHigh=4G
MemoryAccounting=yes

# Sandboxing — DELIBERATELY conservative. This service runs as root and is the
# one that legitimately needs broad power: it drives systemctl, drops to
# APP_USER via su/sudo (both setuid), reads sysfs/debugfs, and rewrites
# /etc/nginx + /etc/systemd + the web root during an in-app Update. So the
# usual heavy directives are OFF ON PURPOSE — NoNewPrivileges/RestrictSUIDSGID
# would break su/sudo; ProtectSystem=strict / ProtectHome would break the
# updater and home writes; PrivateTmp would hide the session sockets;
# RestrictNamespaces would break snap-confine (the manager launches snap
# Chromium for /api/browser/open and snap Firefox/Chromium for the X11 Launcher,
# and snap-confine needs to create a mount namespace — with it blocked the
# hand-off `chromium <url>` silently fails to start and the link never opens).
# What's left are the directives that add real protection without touching any
# of that: block kernel tampering, realtime abuse, and personality changes.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
