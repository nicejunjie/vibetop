# Parameterized disposable VM for the install matrix (tests/matrix/run.sh).
#
# One VM per distro, booted serially. Unlike tests/e2e/vm/Vagrantfile this
# forwards no ports and runs no Playwright: every assertion runs INSIDE the
# guest (assert.sh), so the only thing that crosses back is a result line. That
# keeps it usable for distros where the browser stack may not even install.
#
# Driven entirely by env:
#   VIBETOP_BOX     vagrant box to boot            (required)
#   VIBETOP_MATRIX_FULL=1   deploy the heavy stack (default: lean)
box = ENV['VIBETOP_BOX'] or raise "VIBETOP_BOX is required (see tests/matrix/run.sh)"

Vagrant.configure("2") do |config|
  config.vm.box = box
  config.vm.hostname = "vibetop-matrix"

  # Some cloud images ship without the vagrant user's insecure key handling or
  # with SELinux relabeling that makes the default rsync slow/awkward; rsync is
  # still the most portable sync across distro images.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "../..", "/opt/vibetop-src", type: "rsync",
    rsync__exclude: [".git/", ".claude/", "tests/e2e/node_modules/",
                     "tests/e2e/.auth/", "tests/e2e/test-results/",
                     "tests/e2e/playwright-report/"]

  config.vm.provider :libvirt do |lv|
    # A FULL row runs xpra + Chromium + the OnlyOffice container (which alone
    # wants ~2GB RAM), so it needs materially more than a lean row.
    full = ENV.fetch("VIBETOP_MATRIX_FULL", "0") == "1"
    lv.memory = full ? 8192 : 3072
    # DISK, not just RAM: the OnlyOffice image unpacks to well over the cloud
    # image's stock ~10GB root and the first FULL run died with
    # "no space left on device" mid-layer-extract. Cloud images grow the root
    # filesystem on boot, so enlarging the volume is enough.
    lv.machine_virtual_size = full ? 40 : 20
    lv.cpus = 4
    # Distinct domain name per distro so rows can run CONCURRENTLY without
    # fighting over one libvirt domain (paired with a per-distro
    # VAGRANT_DOTFILE_PATH, which run.sh sets).
    lv.default_prefix = "vibetop_matrix_#{ENV.fetch('VIBETOP_MATRIX_NAME', 'x')}"
  end

  config.vm.provision "shell", path: "provision.sh",
    env: { "VIBETOP_MATRIX_FULL" => ENV.fetch("VIBETOP_MATRIX_FULL", "0") }
end
