# Editor / OS cruft
*.swp
*~
.DS_Store
.idea/
.vscode/

# Local secrets / rendered configs (templates are tracked, rendered output is not)
*.local
.env
*.json.bak

# Cloudflare tunnel credentials (never commit)
*.json
!**/package.json
!shell/manifest.json
cert.pem
credentials.json

# Host-local service list (real hostnames/IPs live here, never committed).
# Only the generic example is tracked.
services.json
!apps/utilities/services/services.example.json

# The RTS art gate's recorded measurements — a tracked baseline, written by
# apps/games/rts/tools/art-metrics.js and ratcheted by apps/games/rts/rts-art.test.js.
!apps/games/rts/docs/art-baseline.json

# Python bytecode cache
__pycache__/
*.pyc

# Vagrant runtime state for the disposable test VMs (per-machine ids, pids,
# logs and a throwaway private key) — regenerated on every `vagrant up`.
.vagrant/
# matrix run logs, one per distro, regenerated each run
tests/matrix/logs/
tests/matrix/.vagrant-*/
logs/*.result
apps/games/rts/art/out/

# dev-only AST tool for the RTS module split (acorn); never deployed
apps/games/rts/tools/modularize/node_modules/
apps/games/rts/tools/modularize/package-lock.json
!apps/games/rts/tools/modularize/sections.json
