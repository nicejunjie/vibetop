# Editor / OS cruft
*.swp
*~
.DS_Store
.idea/
.vscode/

# Local secrets / rendered configs (templates are tracked, rendered output is not)
*.local
.env
*.json.bak

# Cloudflare tunnel credentials (never commit)
*.json
!**/package.json
!shell/manifest.json
cert.pem
credentials.json

# Host-local service list (real hostnames/IPs live here, never committed).
# Only the generic example is tracked.
services.json
!apps/utilities/services/services.example.json

# Python bytecode cache
__pycache__/
*.pyc

# Vagrant runtime state for the disposable test VMs (per-machine ids, pids,
# logs and a throwaway private key) — regenerated on every `vagrant up`.
.vagrant/
# matrix run logs, one per distro, regenerated each run
tests/matrix/logs/
tests/matrix/.vagrant-*/
logs/*.result

# The RTS game (Iron Frontier) moved to its own project, rts-war, linked as an
# optional sibling checkout (shell/install.sh). An old checkout keeps ignored
# leftovers under apps/games/rts/ (rendered art, the link to the private RA2
# reference store) after pulling the removal; never let them be re-added. RA2
# reference images are EA/Westwood's copyrighted art and never belong here.
apps/games/rts/
docs/ra2-ref
