# Editor / OS cruft
*.swp
*~
.DS_Store
.idea/
.vscode/

# Local secrets / rendered configs (templates are tracked, rendered output is not)
*.local
.env
*.json.bak

# Cloudflare tunnel credentials (never commit)
*.json
!**/package.json
!shell/manifest.json
cert.pem
credentials.json

# Host-local service list (real hostnames/IPs live here, never committed).
# Only the generic example is tracked.
services.json
!apps/utilities/services/services.example.json

# The RTS art gate's recorded measurements — a tracked baseline, written by
# apps/games/rts/tools/art-metrics.js and ratcheted by apps/games/rts/rts-art.test.js.
!apps/games/rts/docs/art-baseline.json
!apps/games/rts/docs/ra2-ref/manifest.json
# the RTS testkit's goldens, baselines and pinned repros are data the tests read
!apps/games/rts/tools/testkit/golden/*.json
!apps/games/rts/rts/diag/*.json
!apps/games/rts/tools/testkit/data/*.json

# Python bytecode cache
__pycache__/
*.pyc

# Vagrant runtime state for the disposable test VMs (per-machine ids, pids,
# logs and a throwaway private key) — regenerated on every `vagrant up`.
.vagrant/
# matrix run logs, one per distro, regenerated each run
tests/matrix/logs/
tests/matrix/.vagrant-*/
logs/*.result
apps/games/rts/art/out/

# RA2 reference images (ripped sprites, wiki captures, voxel renders) are
# EA/Westwood's copyrighted art: they are NEVER committed. They live in a
# private store on z20 and are linked in by apps/games/rts/tools/ra2-ref-link.sh.
# The #artgallery page's RA2 column (rts/diag/gallery-refs.json) embeds them,
# so it is generated locally and never committed either.
apps/games/rts/docs/ra2-ref
docs/ra2-ref
apps/games/rts/rts/diag/gallery-refs.json
