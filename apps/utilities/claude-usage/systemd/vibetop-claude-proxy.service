[Unit]
Description=vibetop Claude usage proxy (captures Max-plan rate-limit headers)
Documentation=https://github.com/nicejunjie/vibetop
After=network-online.target
Wants=network-online.target
# systemd holds the listening socket (see the .socket unit), so a restart queues
# connections instead of refusing them.
Requires=vibetop-claude-proxy.socket
After=vibetop-claude-proxy.socket
# ...but a PERSISTENT fault must fail fast and visibly rather than queue forever:
# five failed starts in a minute trips the limit, which fails the socket too, so
# callers get an immediate error and a unit in `failed` state that doctor.sh and
# `systemctl status` both report. Without this, a missing binary crash-looped 357
# times in 13 minutes on 2026-09-03 with nothing surfacing it.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Runs as the OPERATOR (the human whose Claude Code is observed) — NOT APP_USER,
# which may be the `vibetop` service account that never runs Claude Code. systemd
# sets $HOME to the operator's home, where the usage JSON is written and where the
# manager reads it (CLAUDE_USAGE_FILE). Loopback-only, in-place from the checkout.
User=@OPERATOR@
Environment=CLAUDE_PROXY_PORT=7690
ExecStart=@APP_DIR@/vibetop-claude-proxy
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
Also=vibetop-claude-proxy.socket
